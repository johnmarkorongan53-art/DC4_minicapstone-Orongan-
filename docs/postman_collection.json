  "item": [
    {"name":"Auth","item":[{"name":"Register athlete","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"}],"url":"{{baseUrl}}/register","body":{"mode":"raw","raw":"{\"name\":\"Mikaela Santos\",\"email\":\"mikaela@example.com\",\"password\":\"strongpass123\",\"password_confirmation\":\"strongpass123\",\"athlete_id_number\":\"ATH-2026-101\",\"birthdate\":\"2005-04-18\",\"sex\":\"female\",\"sport\":\"Swimming\",\"address\":\"Cebu City, Cebu\",\"contact_number\":\"09171234567\"}","options":{"raw":{"language":"json"}}}},"response":[]},{"name":"Login admin or athlete","event":[{"listen":"test","script":{"exec":["if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().token); }"],"type":"text/javascript"}}],"request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/login","body":{"mode":"raw","raw":"{\"email\":\"admin@example.com\",\"password\":\"password\"}","options":{"raw":{"language":"json"}}}},"response":[]},{"name":"Current user","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{baseUrl}}/user"}},{"name":"Logout","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"}],"url":"{{baseUrl}}/logout"}}]},
    {"name":"Lookups","item":[{"name":"Training types","request":{"method":"GET","url":"{{baseUrl}}/training-types"}},{"name":"Session statuses","request":{"method":"GET","url":"{{baseUrl}}/session-statuses"}}]},
    {"name":"Athlete","item":[{"name":"My profile","request":{"method":"GET","url":"{{baseUrl}}/my-profile"}},{"name":"Update my profile","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/my-profile","body":{"mode":"raw","raw":"{\"contact_number\":\"09171234567\",\"address\":\"Cebu City\"}"}}},{"name":"My progress","request":{"method":"GET","url":"{{baseUrl}}/my-progress"}},{"name":"List my sessions","request":{"method":"GET","url":"{{baseUrl}}/my-sessions?per_page=10"}},{"name":"Schedule my session","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/my-sessions","body":{"mode":"raw","raw":"{\"training_type_id\":{{typeId}},\"title\":\"Tempo intervals\",\"session_date\":\"2026-11-01\",\"start_time\":\"07:00\",\"end_time\":\"08:00\",\"intensity\":\"medium\"}"}}},{"name":"View my session","request":{"method":"GET","url":"{{baseUrl}}/my-sessions/{{sessionId}}"}},{"name":"Edit scheduled session","request":{"method":"PUT","url":"{{baseUrl}}/my-sessions/{{sessionId}}","body":{"mode":"raw","raw":"{\"training_type_id\":{{typeId}},\"title\":\"Updated routine\",\"session_date\":\"2026-11-01\",\"start_time\":\"07:00\",\"end_time\":\"08:00\"}"}}},{"name":"Start session","request":{"method":"PATCH","url":"{{baseUrl}}/my-sessions/{{sessionId}}/start"}},{"name":"Complete and log","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/my-sessions/{{sessionId}}/complete","body":{"mode":"raw","raw":"{\"duration_minutes\":45,\"perceived_exertion\":7,\"distance_km\":5.2,\"athlete_notes\":\"Felt strong\"}"}}},{"name":"Cancel scheduled session","request":{"method":"PATCH","url":"{{baseUrl}}/my-sessions/{{sessionId}}/cancel"}}]},
    {"name":"Admin","item":[{"name":"Dashboard","request":{"method":"GET","url":"{{baseUrl}}/admin/dashboard"}},{"name":"Search athletes","request":{"method":"GET","url":"{{baseUrl}}/admin/athletes?search=Mikaela&sport=Swimming&per_page=10"}},{"name":"Create athlete record","request":{"method":"POST","url":"{{baseUrl}}/admin/athletes","body":{"mode":"raw","raw":"{\"athlete_id_number\":\"ATH-2026-102\",\"first_name\":\"Paolo\",\"last_name\":\"Reyes\",\"birthdate\":\"2004-06-10\",\"sex\":\"male\",\"sport\":\"Basketball\",\"address\":\"Mandaue City, Cebu\",\"contact_number\":\"09181234567\"}"}}},{"name":"View athlete","request":{"method":"GET","url":"{{baseUrl}}/admin/athletes/{{athleteId}}"}},{"name":"Update athlete","request":{"method":"PUT","url":"{{baseUrl}}/admin/athletes/{{athleteId}}","body":{"mode":"raw","raw":"{\"team\":\"Cebu Performance Club\"}"}}},{"name":"Delete athlete","request":{"method":"DELETE","url":"{{baseUrl}}/admin/athletes/{{athleteId}}"}},{"name":"Search sessions","request":{"method":"GET","url":"{{baseUrl}}/admin/training-sessions?status=scheduled&date=2026-11-01&per_page=10"}},{"name":"Schedule session","request":{"method":"POST","url":"{{baseUrl}}/admin/training-sessions","body":{"mode":"raw","raw":"{\"athlete_id\":{{athleteId}},\"training_type_id\":{{typeId}},\"title\":\"Strength circuit\",\"session_date\":\"2026-11-01\",\"start_time\":\"08:00\",\"end_time\":\"09:00\"}"}}},{"name":"View session","request":{"method":"GET","url":"{{baseUrl}}/admin/training-sessions/{{sessionId}}"}},{"name":"Edit session","request":{"method":"PUT","url":"{{baseUrl}}/admin/training-sessions/{{sessionId}}","body":{"mode":"raw","raw":"{\"athlete_id\":{{athleteId}},\"training_type_id\":{{typeId}},\"title\":\"Updated session\",\"session_date\":\"2026-11-01\",\"start_time\":\"08:00\"}"}}},{"name":"Change status","request":{"method":"PATCH","url":"{{baseUrl}}/admin/training-sessions/{{sessionId}}/status","body":{"mode":"raw","raw":"{\"status\":\"cancelled\"}"}}},{"name":"Review completed log","request":{"method":"PATCH","url":"{{baseUrl}}/admin/training-sessions/{{sessionId}}/review","body":{"mode":"raw","raw":"{\"coach_feedback\":\"Good consistency and controlled effort.\"}"}}},{"name":"Delete session","request":{"method":"DELETE","url":"{{baseUrl}}/admin/training-sessions/{{sessionId}}"}},{"name":"Create training type","request":{"method":"POST","url":"{{baseUrl}}/admin/training-types","body":{"mode":"raw","raw":"{\"name\":\"Mobility\",\"description\":\"Mobility and flexibility training\",\"is_active\":true}"}}},{"name":"Update training type","request":{"method":"PUT","url":"{{baseUrl}}/admin/training-types/{{typeId}}","body":{"mode":"raw","raw":"{\"description\":\"Updated category details\"}"}}},{"name":"Delete training type","request":{"method":"DELETE","url":"{{baseUrl}}/admin/training-types/{{typeId}}"}}]}]
