{
  "name": "stride/athlete-training-api",
  "type": "project",
  "description": "Athlete Training Routine Scheduling and Monitoring API",
  "require": { "php": "^8.2", "laravel/framework": "^12.0", "laravel/sanctum": "^4.0" },
  "require-dev": { "phpunit/phpunit": "^11.0", "fakerphp/faker": "^1.23" },
  "autoload": { "psr-4": { "App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/" } },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "scripts": { "post-autoload-dump": [ "@php artisan package:discover --ansi" ], "test": "@php artisan test" },
  "config": { "optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true },
  "minimum-stability": "stable", "prefer-stable": true
}
